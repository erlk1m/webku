---
import { SeriesPostList } from '@components/post/SeriesPostList';
import SeriesProgress from '@components/post/SeriesProgress.astro';
import HomeSiderSegmented from '@components/ui/segmented/HomeSiderSegmented';
import { HomeSiderSegmentType, HomeSiderType } from '@constants/enum';
import { translateCategoryName } from '@lib/content';
import { getPostSlug } from '@lib/content/locale';
import { getPostLastCategory, getSeriesPosts } from '@lib/content/posts';
import { toPostRefs } from '@lib/content/transforms';
import { cn } from '@lib/utils';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl } from '@/i18n';
import HomeInfo from './HomeInfo.astro';
import { TableOfContents } from './TableOfContents/index';

interface Props {
  type?: HomeSiderType;
  className?: string;
  isDrawer?: boolean;
  post?: BlogPost;
}

const { type = HomeSiderType.HOME, className, isDrawer = false, post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const defaultSegmentType = type === HomeSiderType.POST ? HomeSiderSegmentType.DIRECTORY : HomeSiderSegmentType.INFO;

// 获取系列文章（转换为轻量级引用）
const seriesPosts = post && type === HomeSiderType.POST ? toPostRefs(await getSeriesPosts(post, locale)) : [];

const currentSlug = post ? getPostSlug(post) : '';
const seriesName = post && type === HomeSiderType.POST ? translateCategoryName(getPostLastCategory(post).name, locale) : '';
---

<div
  class={cn(
    isDrawer
      ? 'drawer-sider flex min-h-0 flex-1 flex-col px-3'
      : 'page-home-sider sider-column sticky self-start flex w-64 shrink-0 flex-col items-stretch tablet:hidden px-3 pb-4',
    className,
  )}
  transition:name={isDrawer ? 'page-home-sider-drawer' : 'page-home-sider'}
>
  {
    type === HomeSiderType.POST && (
      <div data-sider-segmented class={isDrawer ? 'shrink-0 pt-2 pb-4' : 'shrink-0 pt-3 pb-2'}>
        <HomeSiderSegmented
          client:only="react"
          className="flex w-full justify-between text-sm/6"
          itemClass="grow"
          defaultValue={defaultSegmentType}
        />
      </div>
    )
  }

  <sider-content
    class={cn('flex-1 overflow-x-hidden overflow-y-auto overscroll-contain', {
      'toc-scroll-fade scrollbar-hidden': type !== HomeSiderType.POST,
    })}
    data-type={type}
    data-default-type={defaultSegmentType}
  >
    <div slot="info" class="sider-slot" data-slot-type="info">
      <HomeInfo isDrawer={isDrawer} />
    </div>
    <div slot="directory" class="sider-slot overflow-hidden h-full" data-slot-type="directory">
      {type === HomeSiderType.POST && (isDrawer ? (
        <TableOfContents client:visible isDrawer enableNumbering={post?.data.tocNumbering ?? true} />
      ) : (
        <TableOfContents client:media="(min-width: 993px)" enableNumbering={post?.data.tocNumbering ?? true} />
      ))}
    </div>
    <div slot="series" class="sider-slot" data-slot-type="series">
      {type === HomeSiderType.POST && <SeriesPostList client:idle posts={seriesPosts} currentPostSlug={currentSlug || undefined} locale={locale} />}
    </div>
  </sider-content>

  <!-- 内联脚本：在 DOM 解析后立即隐藏不需要的内容，避免闪烁（桌面与抽屉各一份，只处理自己所在的侧栏） -->
  <script is:inline data-astro-rerun>
    (function () {
      const container = document.currentScript?.parentElement?.querySelector('sider-content');
      if (!container) return;

      const defaultType = container.getAttribute('data-default-type') || 'info';
      const slots = container.querySelectorAll('.sider-slot');

      slots.forEach((slot) => {
        const slotType = slot.getAttribute('data-slot-type');
        if (slotType !== defaultType) {
          slot.classList.add('hidden');
        }
      });
    })();
  </script>

  {
    type === HomeSiderType.POST && (
      <SeriesProgress posts={seriesPosts} currentSlug={currentSlug} seriesName={seriesName} locale={locale} />
    )
  }
</div>

<script>
  import { HomeSiderSegmentType, HomeSiderType } from '@constants/enum';
  import { readMotionLevel, subscribeMotionLevel } from '@lib/motion-level';
  import { homeSiderSegmentType } from '@store/app';

  const PANEL_ORDER = [HomeSiderSegmentType.INFO, HomeSiderSegmentType.DIRECTORY, HomeSiderSegmentType.SERIES];
  const EASE_OUT_EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const EASE_IN_QUART = 'cubic-bezier(0.5, 0, 0.75, 0)';
  /** Rows that cascade in on a lively switch: profile blocks and nav buttons, TOC entries, series posts. */
  const CASCADE_ROWS =
    '[data-home-profile] > *, [data-home-nav] > *, .toc-container > :not([data-toc-rail]), [data-series-list] > *';
  const CASCADE_SPREAD_MS = 180;

  type Frame = { opacity: string; translate: string };

  function frameOf(element: HTMLElement): Frame {
    const style = getComputedStyle(element);
    return { opacity: style.opacity, translate: style.translate };
  }

  class SiderContent extends HTMLElement {
    private panels = new Map<HomeSiderSegmentType, HTMLElement>();
    private unsubscribeStore: (() => void) | null = null;
    private unsubscribeMotion: (() => void) | null = null;
    private currentType: HomeSiderSegmentType | null = null;
    private animations: Animation[] = [];
    private rowAnimations = new Set<Animation>();

    connectedCallback() {
      const type = this.getAttribute('data-type');
      this.panels.set(HomeSiderSegmentType.INFO, this.querySelector('[slot="info"]') as HTMLElement);
      this.panels.set(HomeSiderSegmentType.DIRECTORY, this.querySelector('[slot="directory"]') as HTMLElement);
      this.panels.set(HomeSiderSegmentType.SERIES, this.querySelector('[slot="series"]') as HTMLElement);

      if (type === HomeSiderType.HOME) {
        this.switchPanel(HomeSiderSegmentType.INFO, false);
        return;
      }

      const initial = (this.getAttribute('data-default-type') as HomeSiderSegmentType) || HomeSiderSegmentType.INFO;
      homeSiderSegmentType.set(initial);
      this.switchPanel(initial, false);

      this.unsubscribeStore = homeSiderSegmentType.listen((next) => this.switchPanel(next, true));
      this.unsubscribeMotion = subscribeMotionLevel(() => this.settle());
    }

    disconnectedCallback() {
      this.unsubscribeStore?.();
      this.unsubscribeMotion?.();
      this.unsubscribeStore = null;
      this.unsubscribeMotion = null;
      this.settle();
      this.stopCascade();
    }

    private switchPanel(type: HomeSiderSegmentType, animate: boolean) {
      if (this.currentType === type) return;
      const prevType = this.currentType;
      const prev = prevType ? this.panels.get(prevType) : undefined;
      const next = this.panels.get(type);
      if (!next) return;

      this.stopCascade();

      const level = readMotionLevel();
      const moving = animate && prevType !== null && level !== 'reduced' && this.getClientRects().length > 0;
      // Read before settle() so an interrupted switch carries on from what is on screen.
      const prevFrame = moving && prev ? frameOf(prev) : null;
      const nextFrame = moving && !next.classList.contains('hidden') ? frameOf(next) : null;
      // Absolutely positioned panels (desktop) cross over; in-flow ones (narrow drawer) swap in place.
      const crossover = prev && prevFrame && this.scrollTop === 0 && getComputedStyle(prev).position === 'absolute';

      this.settle();
      this.currentType = type;
      for (const panel of this.panels.values()) {
        panel.classList.toggle('hidden', panel !== next && !(crossover && panel === prev));
      }
      this.scrollTop = 0;
      if (!moving || prevType === null) return;

      const lively = level === 'lively';
      const direction = Math.sign(PANEL_ORDER.indexOf(type) - PANEL_ORDER.indexOf(prevType)) || 1;
      const travel = (lively ? 16 : 8) * direction;
      const cascade = lively && !nextFrame && !this.closest('#mobile-drawer');
      const delay = crossover ? 60 : 0;

      if (crossover) {
        prev.inert = true;
        const exit = prev.animate([prevFrame, { opacity: '0', translate: `${-travel / 2}px 0` }], {
          duration: 150,
          easing: EASE_IN_QUART,
          fill: 'forwards',
        });
        exit.onfinish = () => {
          prev.classList.add('hidden');
          prev.inert = false;
          exit.cancel();
        };
        this.animations.push(exit);
      }

      const from = nextFrame ?? { opacity: '0', translate: cascade ? 'none' : `${travel}px 0` };
      this.animations.push(
        next.animate([{ ...from, offset: 0 }], {
          duration: cascade ? 260 : 380,
          delay,
          easing: EASE_OUT_EXPO,
          fill: 'backwards',
        }),
      );
      if (cascade) this.cascade(next, travel, delay);
    }

    private cascade(panel: HTMLElement, travel: number, delay: number) {
      const view = this.getBoundingClientRect();
      const rows = [...panel.querySelectorAll<HTMLElement>(CASCADE_ROWS)].filter((row) => {
        const box = row.getBoundingClientRect();
        return box.height > 0 && box.bottom > view.top && box.top < view.bottom;
      });
      const step = Math.min(30, CASCADE_SPREAD_MS / Math.max(rows.length - 1, 1));
      // A lone start keyframe animates toward each row's own resting style (some nav rows rest dimmed).
      // Rows are left to finish on their own, so a quick second switch fades them out mid-glide.
      rows.forEach((row, index) => {
        const animation = row.animate([{ opacity: '0', translate: `${travel}px 0`, offset: 0 }], {
          duration: 520,
          delay: delay + 40 + index * step,
          easing: EASE_OUT_EXPO,
          fill: 'backwards',
        });
        this.rowAnimations.add(animation);
        animation.onfinish = () => this.rowAnimations.delete(animation);
      });
    }

    private stopCascade() {
      for (const animation of this.rowAnimations) animation.cancel();
      this.rowAnimations.clear();
    }

    private settle() {
      for (const animation of this.animations) animation.cancel();
      this.animations = [];
      const current = this.currentType ? this.panels.get(this.currentType) : undefined;
      for (const panel of this.panels.values()) {
        panel.inert = false;
        panel.classList.toggle('hidden', panel !== current);
      }
    }
  }

  if (!customElements.get('sider-content')) {
    customElements.define('sider-content', SiderContent);
  }
</script>

<style>
  /* 圣诞模式下调整 z-index，让装饰效果正确显示 */
  :global(html.christmas) .page-home-sider {
    z-index: 5;
  }

  /* The directory fills the space released by the header without changing the article layout. */
  .page-home-sider {
    top: 0;
    height: 100vh;
  }

  @media (width > 992px) {
    .page-home-sider {
      top: 4.25rem;
      height: calc(100vh - 4.25rem);
      transition:
        top 480ms var(--ease-out-expo),
        height 480ms var(--ease-out-expo);
    }

    :global(body:has(#site-header.-translate-y-full)) .page-home-sider {
      top: 0;
      height: 100vh;
      transition-duration: 260ms;
      transition-timing-function: var(--ease-in-quart);
    }
  }

  :global(html.motion-off) .page-home-sider {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-home-sider {
      transition: none;
    }
  }

  sider-content {
    position: relative;
    min-height: 0;
  }

  .sider-slot {
    position: absolute;
    top: auto;
    left: var(--sider-bleed, 0);
    right: var(--sider-bleed, 0);
  }

  @media (768px >= width) {
    .sider-slot {
      position: relative;
      left: auto;
      right: auto;
    }
  }

  .sider-slot.hidden {
    display: none;
  }
</style>
