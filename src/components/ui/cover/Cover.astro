---
import { Routes } from '@constants/router';
import { createArticleStatsConfig, siteConfig } from '@constants/site-config';
import { getPostReadingTime } from '@lib/content/posts';
import { displayDate } from '@lib/date';
import { getLqipStyle } from '@lib/lqip';
import { routeBuilder } from '@lib/route';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import UmamiPVSpan from '@/components/umami/UmamiPVSpan';
import { MAX_WIDTH } from '@/constants/layout';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import SakuraPetals from './SakuraPetals.astro';
import WaveSvg from './wave';

export interface CoverProps {
  data?: BlogPost;
  title?: string;
  /** Utility pages can opt into a shorter cover with a neutral loading surface. */
  compact?: boolean;
}

const { data, title, compact = false } = Astro.props as CoverProps;

const { date, updated, title: dataTitle, draft } = data?.data ?? {};

const readState = data ? getPostReadingTime(data) : null;
const isDraft = import.meta.env.DEV && draft === true;

// 获取横幅图片的 LQIP 样式
const heroImage = data?.data?.cover ?? '/img/site_header_1920.webp';
const bannerLqipStyle = compact ? undefined : getLqipStyle(heroImage);

const locale = getLocaleFromUrl(Astro.url.pathname);

const href = data && localizedPath(routeBuilder(Routes.Post, data), locale);

const pageStatsConfig = href ? createArticleStatsConfig(href) : null;
---

<div
  class:list={[
    'cover-hero relative z-0 flex overflow-hidden',
    compact ? 'h-[42svh] min-h-72 max-h-120 tablet:h-[36svh] tablet:min-h-64' : 'h-[60dvh] max-h-200',
  ]}
>
  <div class="cover-scrim absolute inset-0 h-full bg-black/40"></div>
  <SakuraPetals />
  <div
    class:list={[
      'cover-copy absolute inset-0 flex flex-col items-center justify-center px-5 text-white',
      compact ? 'bottom-[4svh]' : 'bottom-[8dvh]',
    ]}
  >
    {
      title ? (
        <h1
          class:list={[
            'shadow-text word-break flex items-center gap-2 text-center font-bold',
            MAX_WIDTH.content,
            compact
              ? 'text-4xl/[1.15] tracking-[0.08em] tablet:text-3xl/[1.15] tablet:tracking-[0.05em]'
              : 'text-5xl/[1.2] tracking-widest',
          ]}
        >
          {title}
          <Icon
            name="ri:link"
            title={t(locale, "cover.copyLink")}
            class="hover:text-primary cursor-pointer transition-colors duration-300"
            onclick="navigator.clipboard.writeText(window.location.href)"
          />
        </h1>
      ) : data ? (
        <>
          <h1
            class={`shadow-text word-break text-4.5xl text-center font-bold md:text-2xl ${MAX_WIDTH.content} flex flex-wrap items-center justify-center gap-3`}
          >
            {dataTitle ?? title}
            {isDraft && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-yellow-500 px-3 py-1.5 text-base font-semibold text-white shadow-lg backdrop-blur-sm text-shadow-none hover:bg-yellow-500 md:px-2.5 md:py-1 md:text-sm">
                <Icon name="fa6-solid:file-pen" class="h-4 w-4 md:h-3.5 md:w-3.5" />
                {t(locale, 'post.draft')}
              </span>
            )}
          </h1>
          {data && (
            <p class="mt-3 flex flex-wrap items-center justify-center gap-4 md:text-xs">
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:calendar-days" />
                {t(locale, "post.publishedAt", { date: date && displayDate.datetime(date) })}
              </span>
              {updated && (
                <span class="flex items-center gap-1">
                  <Icon name="fa6-solid:calendar-days" />
                  {t(locale, "post.updatedAt", { date: displayDate.datetime(updated) })}
                </span>
              )}
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:pen-nib" /> {t(locale, "post.wordCount", { count: readState?.words })}
              </span>
              <span class="flex items-center gap-1">
                <Icon name="fa6-solid:clock" />
                {readState?.text}
              </span>
              {pageStatsConfig && (
                <span class="flex items-center gap-1">
                  <Icon name="ri:eye-line" class="h-4 w-4" />
                  <UmamiPVSpan client:idle statsConfig={pageStatsConfig} />
                  {t(locale, 'stats.pageviews')}
                </span>
              )}
            </p>
          )}
        </>
      ) : (
        <>
          <h2 class="motion-rise shadow-text font-chill-round text-5xl/[1.2]">{siteConfig?.alternate}</h2>
          <h1 class="motion-rise shadow-text font-chill-round mt-3 text-5xl/[1.2] font-bold tracking-widest" style="--i: 1">{siteConfig?.title}</h1>
          <p class="motion-rise shadow-text mt-5 text-sm tracking-[0.2em]" style="--i: 2">= {siteConfig?.subtitle} =</p>
        </>
      )
    }
  </div>
  <div
    class="relative -z-10 h-full min-h-60 w-full"
    transition:persist="page-cover-banner"
    id="banner-box"
    style={bannerLqipStyle}
  >
    <img
      src={heroImage}
      alt={dataTitle ?? title ?? "cover"}
      class="h-full w-full object-cover"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <WaveSvg />
</div>

<script>
  import { readMotionLevel } from '@lib/motion-level';

  function settleBanner() {
    const image = document.querySelector<HTMLImageElement>('#banner-box img');
    if (!image || readMotionLevel() === 'reduced') return;
    const animate = () => {
      const easing = 'cubic-bezier(0.25, 1, 0.5, 1)';
      image.animate({ transform: ['scale(1.08)', 'scale(1)'] }, { duration: 1800, easing, fill: 'forwards' });
    };
    if (image.complete) {
      animate();
    } else {
      image.addEventListener('load', animate, { once: true });
    }
  }

  settleBanner();
  document.addEventListener('astro:page-load', settleBanner);
</script>
