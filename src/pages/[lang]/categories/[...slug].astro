---
import {
  type Category,
  getCategoryLinks,
  getCategoryList,
  getCategoryNameByLink,
} from '@lib/content';
import { categoryAtPath } from '@lib/content/index-categories';
import { defaultLocale, localeList } from '@/i18n/config';
import CategoryPage from '../../categories/[...slug].astro';

export async function getStaticPaths() {
  const nonDefaultLocales = localeList.filter((l) => l !== defaultLocale);
  const paths = [];

  for (const lang of nonDefaultLocales) {
    const { categories } = await getCategoryList(lang);
    const links = getCategoryLinks(categories, '');

    for (const link of links) {
      const path = link.split('/').map(getCategoryNameByLink);
      paths.push({
        params: { lang, slug: link },
        props: { category: categoryAtPath(categories, path), path, locale: lang },
      });
    }
  }

  return paths;
}

interface Props {
  category: Category | null;
  path: string[];
  locale: string;
}

const { category, path, locale } = Astro.props;
---
<CategoryPage category={category} path={path} locale={locale} />
