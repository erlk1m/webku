---
import CategoryPostList from '@components/category/CategoryPostList.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { seoConfig } from '@constants/site-config';
import { Layout, TwoColumnLayout } from '@layouts/index';
import {
  type Category,
  getCategoryLinks,
  getCategoryList,
  getCategoryNameByLink,
  getSortedPosts,
  translateCategoryName,
} from '@lib/content';
import { categoryAtPath } from '@lib/content/index-categories';
import { defaultLocale, getLocaleFromUrl, t } from '@/i18n';

export async function getStaticPaths() {
  const { categories } = await getCategoryList(defaultLocale);
  return getCategoryLinks(categories, '').map((link) => {
    const path = link.split('/').map(getCategoryNameByLink);
    return {
      params: { slug: link },
      props: { category: categoryAtPath(categories, path), path, locale: defaultLocale },
    };
  });
}

interface Props {
  category: Category | null;
  path: string[];
  locale?: string;
}

const { category: propCategory, path: propPath, locale: propLocale } = Astro.props;
const locale = propLocale ?? getLocaleFromUrl(Astro.url.pathname) ?? defaultLocale;
const allPosts = await getSortedPosts(locale);

// If rendered without props (or by [lang] mirror with different locale)
const slug = Astro.params.slug as string;
const path = propPath ?? (slug ? slug.split('/').map(getCategoryNameByLink) : []);
const { categories } = await getCategoryList(locale);
const category = propCategory ?? categoryAtPath(categories, path);
---

<Layout title={`${t(locale, 'category.postsInCategory', { name: translateCategoryName(category?.name ?? '', locale) })} | ${seoConfig.title}`}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title={t(locale, 'category.postsInCategory', { name: translateCategoryName(category?.name ?? '', locale) })} />
    <HomeSider slot="sider" />
    <CategoryPostList category={category} path={path} allPosts={allPosts} locale={locale} />
  </TwoColumnLayout>
</Layout>
